import csv
import shlex
from pathlib import Path

with open(config['samples_tsv'], newline='') as handle:
    SAMPLES = {row['sample_id']: row for row in csv.DictReader(handle, delimiter='\t')}
if not SAMPLES:
    raise ValueError('Sample sheet is empty')
OUT = config['results_root'].rstrip('/')
LOG = config['log_root'].rstrip('/')
TMP = config['tmp_root'].rstrip('/')
CUSTOMER_DELIVERY = config.get('delivery_root', f'{OUT}/_project/10_delivery/ISO_SLAM_Delivery').rstrip('/')
SAMPLE_SHEET = config['samples_tsv']
PY = config['python_bin']
CONFIG = workflow.configfiles[-1]
TASK = 'pipeline/scripts/snakemake_tasks.py'
container: "docker://iso-slam:20260930-v1.0.0"

wildcard_constraints:
    sample='|'.join(__import__('re').escape(sample) for sample in SAMPLES)

HELPERS = {'raw_qc': ['lr_longread_fastq_qc.py'], 'trim': ['lr_bulk_trim_reads.py'], 'alignment': ['lr_align_reads.py'], 'strand_audit': ['audit_lr_library_strand.py', 'lr_gene_assignment.py'], 'strand_selection': [], 'grand3_reference': [], 'read_calling': ['lr_call_bulk_slam.py', 'lr_gene_assignment.py'], 'isoform_catalog': ['run_isoform_catalog.py', 'iso_slam_v4_common.py'], 'slam_model': ['run_grand3_sample.py', 'iso_slam_v4_common.py'], 'isoform_dynamics': ['build_isoform_dynamics.py'], 'sample_report': ['build_lr_iso_slam_report_v4.py', 'build_lr_iso_slam_read_flow.py', 'report_components.py', '00_shared/validate_bio_report.py'], 'project_qc': ['build_lr_iso_slam_project_qc_v4.py'], 'group_analysis': ['run_iso_slam_group_analysis.R'], 'new_rna_splicing': ['run_new_rna_splicing.py', 'run_new_rna_splicing.R'], 'project_report': ['build_lr_iso_slam_project_report_v4.py', 'report_components.py', '00_shared/validate_bio_report.py'], 'delivery': ['00_shared/validate_bio_report.py'], 'customer_delivery': ['10_delivery/build_iso_slam_delivery_package.py', 'gene_annotation.py', 'iso_slam_v4_common.py']}
SETTINGS = {'raw_qc': ['longread_qc_max_reads', 'enable_nanoplot_qc'], 'trim': ['primer_5p', 'adapter_3p', 'adapter_seed_len', 'adapter_search_window', 'adapter_min_overlap', 'min_insert_len'], 'alignment': ['min_mapq', 'mmi', 'junc_bed'], 'read_calling': ['min_mapq', 'min_tc_baseq', 'min_t_covered', 'min_site_depth', 'min_site_tc_count', 'min_site_tc_rate', 'max_site_other_mismatch_rate', 'max_read_other_mismatch_rate', 'alpha', 'main_call', 'assignment_mode'], 'isoform_catalog': ['isoquant_full_length', 'isoquant_complete_genedb', 'isoquant_data_type'], 'isoform_dynamics': ['posterior_new_threshold', 'posterior_old_threshold', 'posterior_bootstrap_iterations', 'posterior_bootstrap_seed', 'grand_slam_ntr_mae_max'], 'sample_report': ['report_title', 'control_group', 'labeling_design'], 'group_analysis': ['control_group', 'differential_contrasts', 'biological_replicates_per_group'], 'new_rna_splicing': ['differential_contrasts', 'suppa_bin', 'rscript_bin'], 'project_report': ['qc_review_min_raw_reads', 'qc_review_min_fastq_q20_fraction', 'qc_review_min_primary_mapq20_fraction', 'qc_review_min_detected_genes'], 'delivery': ['report_schema'], 'customer_delivery': ['delivery_root', 'delivery_name', 'include_sample_reports']}

CONTRASTS = config.get('differential_contrasts') or [
    {'treatment': config['treatment_group'], 'control': config['control_group']}
]
CONTRAST_NAMES = [f"{item['treatment']}_vs_{item['control']}" for item in CONTRASTS]
DIFFERENTIAL_LAYERS = ['gene_abundance', 'gene_labeling', 'isoform_abundance', 'total_isoform_usage', 'new_isoform_usage']
GROUP_ROOT = f'{OUT}/_project/08_project_qc/02_group_analysis'
SAMPLE_GENE_NAME_VALIDATION = f'{OUT}/_project/08_project_qc/05_metadata/sample_gene_name_annotation.json'
AS_GENE_NAME_VALIDATION = f'{GROUP_ROOT}/tables/differential/new_rna_splicing/gene_name_annotation.json'
SAMPLE_GENE_TABLES = [
    f'{OUT}/{{sample}}/04_isoform_catalog/01_tables/{{sample}}.isoform_catalog.tsv',
    f'{OUT}/{{sample}}/05_slam_model/01_tables/{{sample}}.grand3_gene_ntr.tsv',
    f'{OUT}/{{sample}}/06_isoform_dynamics/01_tables/{{sample}}.gene_dynamics.tsv',
    f'{OUT}/{{sample}}/06_isoform_dynamics/01_tables/{{sample}}.isoform_dynamics.tsv',
    f'{OUT}/{{sample}}/06_isoform_dynamics/01_tables/{{sample}}.isoform_switch_candidates.tsv',
]
GROUP_ARTIFACTS = [f'{GROUP_ROOT}/tables/{name}' for name in (
    'contrast_summary.tsv', 'gene_annotation.tsv', 'sample_gene_abundance_correlations.tsv',
    'sample_labeling_signal.tsv', 'sample_pca_scores.tsv', 'within_group_signal_summary.tsv',
)]
GROUP_ARTIFACTS += [f'{GROUP_ROOT}/figures/{name}.{ext}' for name in (
    'differential_feature_counts', 'gene_abundance_correlation', 'gene_abundance_pca', 'within_group_labeling_signal',
) for ext in ('png', 'pdf')]
for contrast in CONTRAST_NAMES:
    for layer in DIFFERENTIAL_LAYERS:
        GROUP_ARTIFACTS.append(f'{GROUP_ROOT}/tables/differential/{contrast}/{layer}.tsv')
        GROUP_ARTIFACTS.extend(f'{GROUP_ROOT}/figures/differential/{contrast}/{layer}_{kind}.{ext}'
                               for kind, ext in [('heatmap', 'png'), ('heatmap', 'pdf'), ('heatmap_data', 'tsv'), ('volcano', 'png'), ('volcano', 'pdf')])

def code_for(task):
    inputs = [TASK, SAMPLE_SHEET] + ["pipeline/scripts/" + name for name in HELPERS[task]]
    if task == 'customer_delivery':
        inputs.append('docs/result_review_criteria.md')
        inputs += [
            'pipeline/scripts/10_delivery/build_iso_slam_as_supplement.py',
            'pipeline/scripts/10_delivery/plot_iso_slam_as_supplement.R',
        ]
    if task == 'sample_report':
        inputs += [
            'pipeline/scripts/build_read_flow_sankey.py',
            'pipeline/scripts/validate_read_flow_outputs.py',
            'pipeline/assets/plotly-3.5.1.min.js',
        ]
    return inputs

def settings_for(task):
    values = {key: config.get(key) for key in SETTINGS.get(task, [])}
    if task == 'customer_delivery':
        values['rscript_bin'] = config.get('rscript_bin')
    return values

def stage(sample, name):
    return f'{OUT}/{sample}/{name}'

rule all:
    input:
        f'{OUT}/_project/RUN_COMPLETE.tsv',
        f'{CUSTOMER_DELIVERY}/DELIVERY_VALIDATION.json'

rule raw_qc:
    input:
        lambda w: SAMPLES[w.sample]['fastq'],
        code=code_for("raw_qc")
    output: f'{OUT}/{{sample}}/01_raw_qc/04_tool_output/longread_qc/fastq/{{sample}}.raw_fastq_qc.json'
    params: settings=settings_for("raw_qc")
    log: f'{LOG}/{{sample}}/01_raw_qc.log'
    benchmark: f'{LOG}/{{sample}}/01_raw_qc.benchmark.tsv'
    threads: 1
    resources: mem_mb=4096, sample_slots=1
    shell: '{PY:q} {TASK:q} --config {CONFIG:q} --task raw_qc --sample {wildcards.sample:q} --threads {threads} > {log:q} 2>&1'

rule trim:
    input:
        lambda w: SAMPLES[w.sample]['fastq'],
        code=code_for("trim")
    output:
        reads=f'{OUT}/{{sample}}/02_trim/04_tool_output/trim/{{sample}}.insert.fastq.gz',
        summary=f'{OUT}/{{sample}}/02_trim/04_tool_output/trim/{{sample}}.trim_summary.json'
    params: settings=settings_for("trim")
    log: f'{LOG}/{{sample}}/02_trim.log'
    benchmark: f'{LOG}/{{sample}}/02_trim.benchmark.tsv'
    threads: 1
    resources: mem_mb=4096, sample_slots=1
    shell: '{PY:q} {TASK:q} --config {CONFIG:q} --task trim --sample {wildcards.sample:q} --threads {threads} > {log:q} 2>&1'

rule alignment:
    input:
        reads=rules.trim.output.reads,
        reference=config.get('mmi') or config['genome_fa'],
        gtf=config['gtf'],
        code=code_for("alignment")
    output:
        sorted=f'{OUT}/{{sample}}/03_alignment/04_tool_output/minimap2_samtools/{{sample}}.sorted.bam',
        primary=f'{OUT}/{{sample}}/03_alignment/04_tool_output/minimap2_samtools/{{sample}}.primary.q20.bam',
        index=f'{OUT}/{{sample}}/03_alignment/04_tool_output/minimap2_samtools/{{sample}}.primary.q20.bam.bai',
        flagstat=f'{OUT}/{{sample}}/03_alignment/04_tool_output/minimap2_samtools/{{sample}}.flagstat.txt',
        primary_flagstat=f'{OUT}/{{sample}}/03_alignment/04_tool_output/minimap2_samtools/{{sample}}.primary.flagstat.txt'
    params: settings=settings_for("alignment")
    log: f'{LOG}/{{sample}}/03_alignment.log'
    benchmark: f'{LOG}/{{sample}}/03_alignment.benchmark.tsv'
    threads: int(config.get('threads', 8))
    resources: mem_mb=32768, sample_slots=1
    shell: '{PY:q} {TASK:q} --config {CONFIG:q} --task alignment --sample {wildcards.sample:q} --threads {threads} > {log:q} 2>&1'

